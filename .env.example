# Supabase project URL (client-safe, embedded in browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (client-safe, embedded in browser bundle)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -- Edge Functions secrets (set via `supabase secrets set`, NOT here) --
# SUPABASE_SERVICE_ROLE_KEY  -- set in Supabase Dashboard → Edge Functions → Secrets
# ADMIN_PASSWORD             -- set in Supabase Dashboard → Edge Functions → Secrets
